{
  "name": "@aiwa/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup --format cjs",
    "clean": "rm -rf dist .turbo",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src scripts test --max-warnings=0",
    "smoke:byteplus": "node --env-file-if-exists=../../.env --import tsx scripts/byteplus-smoke.ts",
    "smoke:byteplus:voice": "node --env-file-if-exists=../../.env --import tsx scripts/byteplus-voice-smoke.ts",
    "smoke:byteplus:voice:ab": "node --env-file-if-exists=../../.env --import tsx scripts/byteplus-voice-smoke.ts --ab",
    "start": "node dist/index.cjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aiwa/assets": "workspace:*",
    "@aiwa/config": "workspace:*",
    "@aiwa/core": "workspace:*",
    "@aiwa/credits": "workspace:*",
    "@aiwa/db": "workspace:*",
    "@aiwa/generation": "workspace:*",
    "@aiwa/mail": "workspace:*",
    "@aiwa/providers": "workspace:*",
    "@prisma/client": "6.19.3",
    "bullmq": "6.3.5",
    "ioredis": "^5.8.1",
    "sharp": "0.35.5",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "vitest": "^4.1.11"
  }
}
