[Unit]
Description=Aiwa Creators Platform background worker
After=network-online.target mariadb.service redis-server.service
Wants=network-online.target mariadb.service redis-server.service
ConditionPathExists=/var/www/creator-platform/current/apps/worker/dist/index.cjs

[Service]
Type=simple
User=aiwa-creator
Group=aiwa-creator
WorkingDirectory=/var/www/creator-platform/current
EnvironmentFile=/etc/aiwa-creators/creator.env
EnvironmentFile=-/var/www/creator-platform/current/release.env
Environment=NODE_OPTIONS=--max-old-space-size=192
ExecStart=/usr/bin/node /var/www/creator-platform/current/apps/worker/dist/index.cjs
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
