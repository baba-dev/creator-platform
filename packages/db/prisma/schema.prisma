  userId      String @id
  postId      String
  post        LearnPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  checkedAt   DateTime @default(now())
  expiresAt   DateTime
  convertedAt DateTime?
  @@index([convertedAt, expiresAt])
}
