{
  "name": "@aiwa/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "clean": "rm -rf src/generated .turbo",
    "format:schema": "prisma format",
    "generate": "prisma generate",
    "lint": "eslint src prisma --max-warnings=0 && prisma validate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "prisma db seed",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "vitest": "^4.1.11"
  }
}
