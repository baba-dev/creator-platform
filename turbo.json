{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env", ".env.local"],
  "globalEnv": ["NODE_ENV", "APP_ENV"],
  "globalPassThroughEnv": [
    "APP_URL",
    "AUTH_SECRET",
    "DATABASE_URL",
    "SIGNUPS_ENABLED",
    "REDIS_URL",
    "ASSET_STORAGE_ROOT",
    "NODE_OPTIONS",
    "UV_THREADPOOL_SIZE",
    "VITEST_MAX_WORKERS",
    "RAYON_NUM_THREADS",
    "NEXT_TELEMETRY_DISABLED",
    "TURBO_CACHE_DIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [],
      "env": ["APP_VERSION"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["GENERATION_INTEGRATION_TEST"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
