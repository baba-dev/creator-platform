[Unit]
Description=Aiwa Creators Platform %i worker
After=network-online.target mariadb.service redis-server.service
Wants=network-online.target mariadb.service redis-server.service
ConditionPathExists=/var/www/creator-platform/current/apps/worker/dist/index.cjs

[Service]
Type=simple
User=aiwa-creator
Group=aiwa-creator
WorkingDirectory=/var/www/creator-platform/current
EnvironmentFile=/etc/aiwa-creators/creator.env
EnvironmentFile=-/var/www/creator-platform/current/release.env
Environment=NODE_OPTIONS=--max-old-space-size=128
Environment=HOME=/var/www/creator-platform
Environment=XDG_CACHE_HOME=/var/www/creator-platform/.cache
Environment=XDG_CONFIG_HOME=/var/www/creator-platform/.config
Environment=XDG_STATE_HOME=/var/www/creator-platform/.local/state
CPUAccounting=true
MemoryAccounting=true
CPUWeight=100
MemoryHigh=192M
MemoryMax=256M
TasksMax=128
KillMode=control-group
ExecStart=/usr/bin/env WORKER_ROLE=%i /usr/bin/node /var/www/creator-platform/current/apps/worker/dist/index.cjs
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
# 600s max provider request + 120s media transfer + 60s shutdown margin.
TimeoutStopSec=780s
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/creator-platform/releases /var/www/creator-platform/current
ReadWritePaths=/var/www/creator-platform/shared /var/www/creator-platform/.cache /var/www/creator-platform/.config /var/www/creator-platform/.local/state
InaccessiblePaths=/var/www/creator-platform/incoming
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
