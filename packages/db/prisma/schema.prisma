generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MembershipRole {
  ORGANIZATION_OWNER
  ORGANIZATION_MEMBER
  ORGANIZATION_VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum PlatformRole {
  USER
  SUPPORT
  OPERATOR
  FINANCE_ADMIN
  PLATFORM_ADMIN
  PLATFORM_OWNER
}

enum PaymentMethod {
  CASH
  CHEQUE
}

enum PaymentStatus {
  DRAFT
  PENDING
  CONFIRMED
  REJECTED
  REVERSED
}

enum LedgerEntryType {
  PAYMENT_GRANT
  ADMIN_GRANT
  RESERVATION
  CAPTURE
  RELEASE
  REFUND
  ADJUSTMENT
  REVERSAL
}

enum ModelProvider {
  BYTEPLUS
  NVIDIA
  GROQ
  GEMINI
  CLOUDFLARE
}

enum MediaKind {
  IMAGE
  VIDEO
  VOICE
  REASONING
  TEXT
}

enum PricingDimension {
  TOKEN
  REQUEST
  CHARACTER
  SECOND
}

enum ProviderToolExecutionMode {
  ASYNC
  SYNC
}

enum ProviderToolPricingMetric {
  INPUT_BYTE
  REQUEST
  INPUT_SECOND
  OUTPUT_SECOND
}

enum ProviderToolExecutionStatus {
  QUEUED
  SUBMITTING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  MANUAL_REVIEW
}

enum GenerationJobStatus {
  DRAFT
  QUOTED
  CREDIT_RESERVED
  QUEUED
  SUBMITTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  MANUAL_REVIEW
}

enum GenerationTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssetStatus {
  PENDING
  READY
  QUARANTINED
  DELETED
  PURGING
  PURGED
}

enum AssetPurpose {
  GENERAL
  REFERENCE_INPUT
}

enum AssetMediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

enum AssetSourceType {
  GENERATED
  UPLOADED
  IMPORTED
  DERIVED
  EXTERNAL
}

enum GenerationInputRole {
  LEGACY
  FIRST_FRAME
  LAST_FRAME
  REFERENCE_IMAGE
  REFERENCE_VIDEO
  REFERENCE_AUDIO
  SOURCE_VIDEO
  AVATAR_IMAGE
  DRIVING_AUDIO
}

enum ImageOperationStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum AssetStorageProvider {
  LOCAL
  S3
  GOOGLE_DRIVE
  ONEDRIVE
}

enum AssetVariantKind {
  THUMBNAIL
  PREVIEW
  POSTER
  STORYBOARD
  WAVEFORM
}

model User {
  id                     String                   @id @default(cuid())
  name                   String
  email                  String                   @unique
  emailVerified          Boolean                  @default(false)
  image                  String?                  @db.Text
  platformRole           PlatformRole             @default(USER)
  disabledAt             DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  sessions               Session[]
  accounts               Account[]
  memberships            Membership[]
  onboardedOrganization  Organization?            @relation("SelfServeOrganization")
  createdPayments        ManualPayment[]          @relation("PaymentCreatedBy")
  confirmedPayments      ManualPayment[]          @relation("PaymentConfirmedBy")
  priceVersions          ModelPriceVersion[]      @relation("PriceVersionCreatedBy")
  providerToolPrices     ProviderToolPriceVersion[] @relation("ProviderToolPriceCreatedBy")
  providerToolExecutions ProviderToolExecution[]   @relation("ProviderToolExecutionCreatedBy")
  generationJobs         GenerationJob[]          @relation("GenerationCreatedBy")
  reasoningJobs          ReasoningJob[]           @relation("ReasoningCreatedBy")
  ownedOrganizations     Organization[]           @relation("OrganizationOwner")
  storageAssets          Asset[]                  @relation("AssetStorageOwner")
  createdAssets          Asset[]                  @relation("AssetCreatedBy")
  uploadedAssets         Asset[]                  @relation("AssetUploadedBy")
  assetFavorites         AssetFavorite[]
  auditEvents            AuditEvent[]             @relation("AuditActor")
  createdInvitations     OrganizationInvitation[] @relation("InvitationCreatedBy")
  acceptedInvitations    OrganizationInvitation[] @relation("InvitationAcceptedBy")
  twoFactorEnabled       Boolean                  @default(false)
  twoFactors             TwoFactor[]
  notificationPreference NotificationPreference?
  templateFavorites      TemplateFavorite[]
  personas               Persona[]
  chatThreads            ChatThread[]
  scripts                Script[]
  brandProfiles          BrandProfile[]
  storyPlans             StoryPlan[]
  externalStorageConfigs ExternalStorageConfig[]
  pixelPreferences       PixelPreference[]
  promptEnhancementPreferences PromptEnhancementPreference[]
  assistantReminders     AssistantReminder[]
  supportRequests        SupportRequest[]
  assistantSettings      AssistantSetting[]

  @@index([platformRole, disabledAt])
}

model Session {
  id                   String        @id @default(cuid())
  token                String        @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?       @db.Text
  userId               String
  activeOrganizationId String?
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([userId])
  @@index([activeOrganizationId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String    @db.Text
  backupCodes             String    @db.Text
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([userId])
}

model NotificationPreference {
  userId              String   @id
  generationCompleted Boolean  @default(true)
  generationFailed    Boolean  @default(true)
  reports             Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id                     String                   @id @default(cuid())
  name                   String
  slug                   String                   @unique
  status                 OrganizationStatus       @default(ACTIVE)
  selfServeCreatorUserId String?                  @unique
  ownerUserId            String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  selfServeCreator       User?                    @relation("SelfServeOrganization", fields: [selfServeCreatorUserId], references: [id], onDelete: SetNull)
  owner                  User                     @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  activeSessions         Session[]
  wallet                 Wallet?
  memberships            Membership[]
  payments               ManualPayment[]
  projects               Project[]
  generationJobs         GenerationJob[]
  providerToolExecutions ProviderToolExecution[]
  reasoningJobs          ReasoningJob[]
  auditEvents            AuditEvent[]
  assets                 Asset[]
  assetFolders           AssetFolder[]
  assetTags              AssetTag[]
  assetStorageUsage      AssetStorageUsage?
  invitations            OrganizationInvitation[]
  personas               Persona[]
  chatThreads            ChatThread[]
  scripts                Script[]
  brandProfiles          BrandProfile[]
  storyPlans             StoryPlan[]
  defaultStorageProvider AssetStorageProvider     @default(LOCAL)
  externalStorageConfigs ExternalStorageConfig[]
  pixelPreferences       PixelPreference[]
  promptEnhancementPreferences PromptEnhancementPreference[]
  assistantReminders     AssistantReminder[]
  supportRequests        SupportRequest[]

  @@index([status])
  @@index([ownerUserId])
  @@index([status, createdAt])
}

model Membership {
  id                        String         @id @default(cuid())
  organizationId            String
  userId                    String
  role                      MembershipRole @default(ORGANIZATION_MEMBER)
  monthlySpendingCapCredits BigInt?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  organization              Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model Wallet {
  id             String        @id @default(cuid())
  organizationId String        @unique
  balanceCache   BigInt        @default(0)
  version        Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entries        LedgerEntry[]
}

model LedgerEntry {
  id             String          @id @default(cuid())
  walletId       String
  type           LedgerEntryType
  amountCredits  BigInt
  balanceAfter   BigInt
  idempotencyKey String          @unique
  referenceType  String?
  referenceId    String?
  reversalOfId   String?
  description    String?         @db.Text
  metadata       Json?
  createdAt      DateTime        @default(now())
  wallet         Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  reversalOf     LedgerEntry?    @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals      LedgerEntry[]   @relation("LedgerReversal")

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@index([reversalOfId])
}

model ManualPayment {
  id                      String        @id @default(cuid())
  organizationId          String
  method                  PaymentMethod
  status                  PaymentStatus @default(DRAFT)
  amountBaisa             BigInt
  reference               String?
  chequeNumber            String?
  bankName                String?
  notes                   String?       @db.Text
  receivedAt              DateTime
  confirmedAt             DateTime?
  rejectedAt              DateTime?
  reversedAt              DateTime?
  rejectionReason         String?       @db.Text
  rejectionIdempotencyKey String?       @unique
  reversalReason          String?       @db.Text
  creditsGranted          BigInt?
  creditsPerBaisa         BigInt?
  idempotencyKey          String        @unique
  createdById             String
  confirmedById           String?
  ledgerEntryId           String?       @unique
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  organization            Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy               User          @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy             User?         @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([method, receivedAt])
}

model Project {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  description    String?         @db.Text
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  generationJobs GenerationJob[]
  assets         Asset[]
  chatThreads    ChatThread[]
  scripts        Script[]
  storyPlans     StoryPlan[]

  @@index([organizationId, archivedAt])
}

model ProviderModel {
  id                    String              @id @default(cuid())
  provider              ModelProvider
  providerModelId       String
  mediaKind             MediaKind
  displayName           String
  description           String              @db.Text
  capabilities          Json
  negotiatedDiscountBps Int                 @default(0)
  enabled               Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  priceVersions         ModelPriceVersion[]
  generationJobs        GenerationJob[]
  reasoningJobs         ReasoningJob[]
  personaPreferences    Persona[]            @relation("PersonaProviderModel")
  chatThreads           ChatThread[]         @relation("ChatThreadProviderModel")
  assistantSettings     AssistantSetting[]

  @@unique([provider, providerModelId])
  @@index([mediaKind, enabled])
}

model ModelPriceVersion {
  id                    String           @id @default(cuid())
  providerModelId       String
  providerCostMicroUsd  BigInt
  publicationKey        String?          @unique @db.VarChar(36)
  publicationHash       String?          @db.VarChar(64)
  usageRates            Json?
  providerCostBasisNote String?          @db.VarChar(255)
  videoInputRate720p    BigInt?
  videoInputRate1080p   BigInt?
  customerCredits       BigInt
  fxBaisaNumerator      BigInt
  fxBaisaDenominator    BigInt
  targetMarginBps       Int
  pricingDimension      PricingDimension @default(REQUEST)
  unitQuantity          Int              @default(1)
  creditsPerBaisa       BigInt           @default(1)
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  createdById           String
  createdAt             DateTime         @default(now())
  providerModel         ProviderModel    @relation(fields: [providerModelId], references: [id], onDelete: Restrict)
  createdBy             User             @relation("PriceVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  generationJobs        GenerationJob[]
  reasoningJobs         ReasoningJob[]

  @@index([providerModelId, effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
}


model ProviderTool {
  id            String                    @id @default(cuid())
  provider      ModelProvider
  providerToolId String
  displayName   String
  description   String                    @db.Text
  category      String                    @db.VarChar(32)
  executionMode ProviderToolExecutionMode
  pricingMetric ProviderToolPricingMetric
  capabilities  Json
  enabled       Boolean                   @default(false)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  priceVersions ProviderToolPriceVersion[]
  executions    ProviderToolExecution[]

  @@unique([provider, providerToolId])
  @@index([enabled, category])
}

model ProviderToolPriceVersion {
  id                    String                    @id @default(cuid())
  providerToolId        String
  publicationKey        String?                   @unique @db.VarChar(36)
  publicationHash       String?                   @db.VarChar(64)
  providerCostMicroUsd          BigInt
  providerCostNoOutputMicroUsd  BigInt?
  customerCredits               BigInt
  fxBaisaNumerator      BigInt
  fxBaisaDenominator    BigInt
  targetMarginBps       Int
  pricingMetric         ProviderToolPricingMetric
  unitQuantity          Int                       @default(1)
  creditsPerBaisa       BigInt                    @default(1)
  proportional          Boolean                   @default(false)
  resolutionRates       Json?
  providerCostBasisNote String?                    @db.VarChar(255)
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  createdById           String
  createdAt             DateTime                  @default(now())
  providerTool          ProviderTool              @relation(fields: [providerToolId], references: [id], onDelete: Restrict)
  createdBy             User                      @relation("ProviderToolPriceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  executions            ProviderToolExecution[]

  @@index([providerToolId, effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
}

model ProviderToolExecution {
  id                         String                      @id @default(cuid())
  organizationId             String
  createdById                String
  providerToolId             String
  priceVersionId             String
  status                     ProviderToolExecutionStatus @default(QUEUED)
  idempotencyKey             String                      @unique @db.VarChar(64)
  requestHash                String                      @db.VarChar(64)
  requestPayload             Json
  resultPayload              Json?
  providerTaskId             String?                     @db.VarChar(191)
  providerRequestId          String?                     @db.VarChar(191)
  quotedQuantity             Int
  actualQuantity             Int?
  reservedCredits            BigInt                      @default(0)
  chargedCredits             BigInt                      @default(0)
  actualProviderCostMicroUsd BigInt?
  retryCount                 Int                         @default(0)
  maxAttempts                Int                         @default(8)
  nextAttemptAt              DateTime?
  errorCode                  String?                     @db.VarChar(128)
  errorMessage               String?                     @db.Text
  submittedAt                DateTime?
  completedAt                DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy                  User                        @relation("ProviderToolExecutionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  providerTool               ProviderTool                @relation(fields: [providerToolId], references: [id], onDelete: Restrict)
  priceVersion               ProviderToolPriceVersion    @relation(fields: [priceVersionId], references: [id], onDelete: Restrict)
  inputAssets                ProviderToolInputAsset[]
  outputAssets               Asset[]

  @@unique([providerToolId, providerTaskId])
  @@index([status, nextAttemptAt, updatedAt])
  @@index([organizationId, createdAt])
  @@index([createdById, createdAt])
}

model ProviderToolInputAsset {
  executionId String
  assetId     String
  position    Int
  role        String                @db.VarChar(32)
  createdAt   DateTime              @default(now())
  execution   ProviderToolExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  asset       Asset                 @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([executionId, assetId])
  @@unique([executionId, position])
  @@index([executionId, role, position])
  @@index([assetId])
}


model GenerationJob {
  id                         String                 @id @default(cuid())
  organizationId             String
  projectId                  String?
  templateId                 String?
  createdById                String
  providerModelId            String
  priceVersionId             String
  status                     GenerationJobStatus    @default(DRAFT)
  idempotencyKey             String                 @unique
  requestPayload             Json
  outputPayload              Json?
  providerRequestId          String?
  reservedCredits            BigInt                 @default(0)
  chargedCredits             BigInt                 @default(0)
  actualProviderCostMicroUsd BigInt?
  providerCostBasis          String?                @db.VarChar(32)
  quotedUnits                Int?
  actualUnits                Int?
  billableQuantity           Int?
  errorCode                  String?
  errorMessage               String?                @db.Text
  quotedAt                   DateTime?
  queuedAt                   DateTime?
  submittedAt                DateTime?
  completedAt                DateTime?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  organization               Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project                    Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  template                   GenerationTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy                  User                   @relation("GenerationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  providerModel              ProviderModel          @relation(fields: [providerModelId], references: [id], onDelete: Restrict)
  priceVersion               ModelPriceVersion      @relation(fields: [priceVersionId], references: [id], onDelete: Restrict)
  parentGenerationId         String?
  chatThreadId               String?
  parentGeneration           GenerationJob?         @relation("GenerationDerivation", fields: [parentGenerationId], references: [id], onDelete: SetNull)
  derivedGenerations         GenerationJob[]        @relation("GenerationDerivation")
  chatThread                 ChatThread?            @relation(fields: [chatThreadId], references: [id], onDelete: SetNull)
  assets                     Asset[]
  inputAssets                GenerationInputAsset[]
  seedAudioSegments          SeedAudioSegment[]

  @@unique([providerModelId, providerRequestId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, createdAt, id])
  @@index([organizationId, createdById, createdAt, id])
  @@index([projectId, createdAt])
  @@index([templateId, createdAt])
  @@index([status, updatedAt])
  @@index([parentGenerationId])
  @@index([chatThreadId])
}

/// Private, restart-safe checkpoints for billable long-form Seed Audio work.
/// These rows are not customer assets; the final GenerationJob Asset remains
/// the canonical output. Checkpoints are deleted only after the final output is
/// durably stored and settled.
model SeedAudioSegment {
  id                String        @id @default(cuid())
  generationJobId   String
  position          Int
  objectKey         String        @unique @db.VarChar(191)
  mimeType          String        @db.VarChar(64)
  byteSize          BigInt
  sha256            String        @db.Char(64)
  providerRequestId String        @db.VarChar(191)
  durationMs        Int
  subtitle          Json?
  usage             Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  generationJob     GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)

  @@unique([generationJobId, position])
  @@index([generationJobId, createdAt])
}

model GenerationTemplate {
  id               String                   @id @default(cuid())
  slug             String                   @unique
  name             String
  description      String                   @db.Text
  category         String
  mediaKind        MediaKind
  status           GenerationTemplateStatus @default(DRAFT)
  promptTemplate   String                   @db.Text
  variables        Json
  defaultInput     Json
  preferredModelId String?
  featured         Boolean                  @default(false)
  sortOrder        Int                      @default(0)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  generationJobs   GenerationJob[]
  favorites        TemplateFavorite[]

  @@index([status, mediaKind, featured, sortOrder])
  @@index([category, status])
}

model TemplateFavorite {
  userId     String
  templateId String
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   GenerationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([userId, templateId])
  @@index([templateId, createdAt])
}

model Asset {
  learnMedia LearnMedia?
  id                    String                 @id @default(cuid())
  organizationId        String
  projectId             String?
  folderId              String?
  generationJobId       String?
  providerToolExecutionId String?
  providerToolOutputIndex Int?
  sourceAssetId         String?
  generationOutputIndex Int?
  storageOwnerUserId    String?
  createdById           String?
  uploadedById          String?
  status                AssetStatus            @default(PENDING)
  purpose               AssetPurpose           @default(GENERAL)
  mediaKind             AssetMediaKind         @default(OTHER)
  sourceType            AssetSourceType        @default(GENERATED)
  storageProvider       AssetStorageProvider   @default(LOCAL)
  name                  String?
  originalFilename      String?
  objectKey             String                 @unique
  externalFileId        String?
  mimeType              String
  byteSize              BigInt
  sha256                String?
  width                 Int?
  height                Int?
  durationMs            Int?
  deletedAt             DateTime?
  purgeAfter            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project               Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  folder                AssetFolder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  generationJob         GenerationJob?         @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  providerToolExecution ProviderToolExecution? @relation(fields: [providerToolExecutionId], references: [id], onDelete: SetNull)
  sourceAsset           Asset?                 @relation("AssetLineage", fields: [sourceAssetId], references: [id], onDelete: Restrict)
  derivedAssets         Asset[]                @relation("AssetLineage")
  imageOperation        ImageOperation?        @relation("ImageOperationOutput")
  sourceOperations      ImageOperation[]       @relation("ImageOperationSource")
  videoRenderOutputs    VideoRender[]          @relation("VideoRenderOutput")
  videoRenderInputs     VideoRenderInput[]
  storageOwner          User?                  @relation("AssetStorageOwner", fields: [storageOwnerUserId], references: [id], onDelete: SetNull)
  createdBy             User?                  @relation("AssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  uploadedBy            User?                  @relation("AssetUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  variants              AssetVariant[]
  generationInputs      GenerationInputAsset[]
  providerToolInputs     ProviderToolInputAsset[]
  tagAssignments        AssetTagAssignment[]
  favorites             AssetFavorite[]

  @@unique([generationJobId, generationOutputIndex])
  @@unique([providerToolExecutionId, providerToolOutputIndex])
  @@index([organizationId, createdAt])
  @@index([organizationId, mediaKind, status, createdAt])
  @@index([organizationId, sourceType, status, createdAt])
  @@index([generationJobId])
  @@index([providerToolExecutionId])
  @@index([sourceAssetId])
  @@index([projectId, status, createdAt])
  @@index([folderId, status, createdAt])
  @@index([status, purgeAfter])
  @@index([organizationId, storageOwnerUserId, status])
  @@index([organizationId, sha256])
}

model ImageOperation {
  id             String               @id @default(cuid())
  organizationId String
  createdById    String
  sourceAssetId  String
  outputAssetId  String               @unique
  idempotencyKey String               @unique
  requestPayload Json
  status         ImageOperationStatus @default(PENDING)
  errorMessage   String?
  processingAt   DateTime?
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  sourceAsset    Asset                @relation("ImageOperationSource", fields: [sourceAssetId], references: [id], onDelete: Restrict)
  outputAsset    Asset                @relation("ImageOperationOutput", fields: [outputAssetId], references: [id], onDelete: Restrict)

