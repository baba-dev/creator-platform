{
  "name": "@aiwa/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup --format cjs",
    "clean": "rm -rf dist .turbo",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src --max-warnings=0",
    "start": "node dist/index.cjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aiwa/config": "workspace:*",
    "@aiwa/core": "workspace:*",
    "@aiwa/providers": "workspace:*",
    "bullmq": "6.3.5",
    "ioredis": "^5.8.1"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "vitest": "^4.1.11"
  }
}
