#!/usr/bin/env bash
set -Eeuo pipefail
umask 027

readonly application_root=/var/www/creator-platform
readonly current_link="$application_root/current"
readonly environment_file=/etc/aiwa-creators/creator.env
readonly runtime_user=aiwa-creator

fail() {
  printf '[creator-ops] ERROR: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat >&2 <<'USAGE'
Usage:
  creator-ops promote-owner <email>
  creator-ops seed-templates
  creator-ops byteplus-smoke
  creator-ops media-status
  creator-ops media-retry <taskId> [--confirm-stopped]
  creator-ops media-abandon <taskId> --confirm-stopped
  creator-ops media-recover-capacity --confirm-stopped
USAGE
  exit 64
}

[[ $EUID -eq 0 ]] || fail "this command must run as root"
[[ -f "$environment_file" ]] || fail "environment file does not exist"

command_name="${1:-}"
shift || true

case "$command_name" in
  promote-owner)
    email="${1:-}"
    [[ $# -eq 1 ]] || usage
    [[ "$email" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] \
      || fail "a valid email address is required"
    ;;
  seed-templates)
    [[ $# -eq 0 ]] || usage
    ;;
  media-status)
    [[ $# -eq 0 ]] || usage
    ;;
  media-retry|media-abandon)
    asset_id="${1:-}"
    [[ $# -ge 1 && $# -le 2 && "$asset_id" =~ ^[A-Za-z0-9_-]{1,128}$ ]] || usage
    confirmation="${2:-}"
    [[ -z "$confirmation" || "$confirmation" == --confirm-stopped ]] || usage
    [[ "$command_name" != media-abandon || "$confirmation" == --confirm-stopped ]] || usage
    ;;
  media-recover-capacity)
    [[ $# -eq 1 && "$1" == --confirm-stopped ]] || usage
    ;;
  byteplus-smoke)
    [[ $# -eq 0 ]] || usage
    ;;
  *)
    usage
    ;;
esac

release_dir="$(readlink -f "$current_link" 2>/dev/null || true)"
[[ -n "$release_dir" && -d "$release_dir" ]] || fail "active release is unavailable"
case "$command_name" in
  promote-owner)
    [[ -x "$release_dir/ops/db/node_modules/.bin/tsx" ]] \
      || fail "active release does not contain operations tooling"
    [[ -f "$release_dir/ops/db/prisma/promote-owner.ts" ]] \
      || fail "owner promotion command is unavailable"
    ;;
  seed-templates)
    [[ -x "$release_dir/ops/db/node_modules/.bin/tsx" ]] \
      || fail "active release does not contain operations tooling"
    [[ -f "$release_dir/ops/db/prisma/seed-templates.ts" ]] \
      || fail "template seed command is unavailable"
    ;;
  media-status|media-retry|media-abandon|media-recover-capacity)
    [[ -f "$release_dir/apps/worker/dist/media-ops.cjs" ]] \
      || fail "media operations command is unavailable"
    ;;
  byteplus-smoke)
    [[ -f "$release_dir/apps/worker/dist/byteplus-smoke.cjs" ]] \
      || fail "BytePlus smoke command is unavailable"
    ;;
esac

runuser --preserve-environment -u "$runtime_user" -- \
  /bin/bash -s -- \
  "$release_dir" \
  "$environment_file" \
  "$command_name" \
  "${email:-${asset_id:-}}" "${confirmation:-}" <<'OPERATIONS'
set -Eeuo pipefail
release_dir="$1"
environment_file="$2"
command_name="$3"
argument="$4"
confirmation="$5"

while IFS= read -r line || [[ -n "$line" ]]; do
  line="${line%$'\r'}"
  [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
  key="${line%%=*}"
  value="${line#*=}"
  [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
  if [[ "$value" =~ ^\".*\"$ || "$value" =~ ^\'.*\'$ ]]; then
    value="${value:1:${#value}-2}"
  fi
  export "$key=$value"
done <"$environment_file"

export HOME=/var/www/creator-platform
export XDG_CACHE_HOME=/var/www/creator-platform/.cache
export XDG_CONFIG_HOME=/var/www/creator-platform/.config
export XDG_STATE_HOME=/var/www/creator-platform/.local/state

case "$command_name" in
  promote-owner)
    cd "$release_dir/ops/db"
    exec ./node_modules/.bin/tsx prisma/promote-owner.ts "$argument"
    ;;
  seed-templates)
    cd "$release_dir/ops/db"
    exec ./node_modules/.bin/tsx prisma/seed-templates.ts
    ;;
  media-status)
    cd "$release_dir"
    exec /usr/bin/node apps/worker/dist/media-ops.cjs status
    ;;
  media-retry)
    cd "$release_dir"
    if [[ -n "$confirmation" ]]; then exec /usr/bin/node apps/worker/dist/media-ops.cjs retry "$argument" "$confirmation"; fi
    exec /usr/bin/node apps/worker/dist/media-ops.cjs retry "$argument"
    ;;
  media-abandon)
    cd "$release_dir"
    exec /usr/bin/node apps/worker/dist/media-ops.cjs abandon "$argument" --confirm-stopped
    ;;
  media-recover-capacity)
    cd "$release_dir"
    exec /usr/bin/node apps/worker/dist/media-ops.cjs recover-capacity --confirm-stopped
    ;;
  byteplus-smoke)
    export BYTEPLUS_SMOKE_OUTPUT_DIR=/var/www/creator-platform/shared/byteplus-smoke
    mkdir -p "$BYTEPLUS_SMOKE_OUTPUT_DIR"
    cd "$release_dir"
    exec /usr/bin/node apps/worker/dist/byteplus-smoke.cjs
    ;;
  *)
    exit 64
    ;;
esac
OPERATIONS
