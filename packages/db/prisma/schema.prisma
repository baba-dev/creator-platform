generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MembershipRole {
  ORGANIZATION_OWNER
  ORGANIZATION_MEMBER
  ORGANIZATION_VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum PlatformRole {
  USER
  SUPPORT
  OPERATOR
  FINANCE_ADMIN
  PLATFORM_ADMIN
  PLATFORM_OWNER
}

enum PaymentMethod {
  CASH
  CHEQUE
}

enum PaymentStatus {
  DRAFT
  PENDING
  CONFIRMED
  REJECTED
  REVERSED
}

enum LedgerEntryType {
  PAYMENT_GRANT
  ADMIN_GRANT
  RESERVATION
  CAPTURE
  RELEASE
  REFUND
  ADJUSTMENT
  REVERSAL
}

enum ModelProvider {
  BYTEPLUS
  NVIDIA
  GROQ
  GEMINI
  CLOUDFLARE
}

enum MediaKind {
  IMAGE
  VIDEO
  VOICE
  REASONING
  TEXT
}

enum PricingDimension {
  TOKEN
  REQUEST
  CHARACTER
  SECOND
}

enum GenerationJobStatus {
  DRAFT
  QUOTED
  CREDIT_RESERVED
  QUEUED
  SUBMITTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  MANUAL_REVIEW
}

enum GenerationTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssetStatus {
  PENDING
  READY
  QUARANTINED
  DELETED
  PURGING
  PURGED
}

enum AssetPurpose {
  GENERAL
  REFERENCE_INPUT
}

enum AssetMediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

enum AssetSourceType {
  GENERATED
  UPLOADED
  IMPORTED
  DERIVED
  EXTERNAL
}

enum GenerationInputRole {
  LEGACY
  FIRST_FRAME
  LAST_FRAME
  REFERENCE_IMAGE
  REFERENCE_VIDEO
  REFERENCE_AUDIO
  SOURCE_VIDEO
  AVATAR_IMAGE
  DRIVING_AUDIO
}

enum ImageOperationStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum AssetStorageProvider {
  LOCAL
  S3
  GOOGLE_DRIVE
  ONEDRIVE
}

enum AssetVariantKind {
  THUMBNAIL
  PREVIEW
  POSTER
  STORYBOARD
  WAVEFORM
}

model User {
  id                     String                   @id @default(cuid())
  name                   String
  email                  String                   @unique
  emailVerified          Boolean                  @default(false)
  image                  String?                  @db.Text
  platformRole           PlatformRole             @default(USER)
  disabledAt             DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  sessions               Session[]
  accounts               Account[]
  memberships            Membership[]
  onboardedOrganization  Organization?            @relation("SelfServeOrganization")
  createdPayments        ManualPayment[]          @relation("PaymentCreatedBy")
  confirmedPayments      ManualPayment[]          @relation("PaymentConfirmedBy")
  priceVersions          ModelPriceVersion[]      @relation("PriceVersionCreatedBy")
  generationJobs         GenerationJob[]          @relation("GenerationCreatedBy")
  reasoningJobs          ReasoningJob[]           @relation("ReasoningCreatedBy")
  ownedOrganizations     Organization[]           @relation("OrganizationOwner")
  storageAssets          Asset[]                  @relation("AssetStorageOwner")
  createdAssets          Asset[]                  @relation("AssetCreatedBy")
  uploadedAssets         Asset[]                  @relation("AssetUploadedBy")
  assetFavorites         AssetFavorite[]
  auditEvents            AuditEvent[]             @relation("AuditActor")
  createdInvitations     OrganizationInvitation[] @relation("InvitationCreatedBy")
  acceptedInvitations    OrganizationInvitation[] @relation("InvitationAcceptedBy")
  twoFactorEnabled       Boolean                  @default(false)
  twoFactors             TwoFactor[]
  notificationPreference NotificationPreference?
  templateFavorites      TemplateFavorite[]
  personas               Persona[]
  chatThreads            ChatThread[]
  scripts                Script[]
  brandProfiles          BrandProfile[]
  storyPlans             StoryPlan[]

  @@index([platformRole, disabledAt])
}

model Session {
  id                   String        @id @default(cuid())
  token                String        @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?       @db.Text
  userId               String
  activeOrganizationId String?
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([userId])
  @@index([activeOrganizationId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String    @db.Text
  backupCodes             String    @db.Text
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([userId])
}

model NotificationPreference {
  userId              String   @id
  generationCompleted Boolean  @default(true)
  generationFailed    Boolean  @default(true)
  reports             Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id                     String                   @id @default(cuid())
  name                   String
  slug                   String                   @unique
  status                 OrganizationStatus       @default(ACTIVE)
  selfServeCreatorUserId String?                  @unique
  ownerUserId            String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  selfServeCreator       User?                    @relation("SelfServeOrganization", fields: [selfServeCreatorUserId], references: [id], onDelete: SetNull)
  owner                  User                     @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  activeSessions         Session[]
  wallet                 Wallet?
  memberships            Membership[]
  payments               ManualPayment[]
  projects               Project[]
  generationJobs         GenerationJob[]
  reasoningJobs          ReasoningJob[]
  auditEvents            AuditEvent[]
  assets                 Asset[]
  assetFolders           AssetFolder[]
  assetTags              AssetTag[]
  assetStorageUsage      AssetStorageUsage?
  invitations            OrganizationInvitation[]
  personas               Persona[]
  chatThreads            ChatThread[]
  scripts                Script[]
  brandProfiles          BrandProfile[]
  storyPlans             StoryPlan[]

  @@index([status])
  @@index([ownerUserId])
  @@index([status, createdAt])
}

model Membership {
  id                        String         @id @default(cuid())
  organizationId            String
  userId                    String
  role                      MembershipRole @default(ORGANIZATION_MEMBER)
  monthlySpendingCapCredits BigInt?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  organization              Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model Wallet {
  id             String        @id @default(cuid())
  organizationId String        @unique
  balanceCache   BigInt        @default(0)
  version        Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entries        LedgerEntry[]
}

model LedgerEntry {
  id             String          @id @default(cuid())
  walletId       String
  type           LedgerEntryType
  amountCredits  BigInt
  balanceAfter   BigInt
  idempotencyKey String          @unique
  referenceType  String?
  referenceId    String?
  reversalOfId   String?
  description    String?         @db.Text
  metadata       Json?
  createdAt      DateTime        @default(now())
  wallet         Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  reversalOf     LedgerEntry?    @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals      LedgerEntry[]   @relation("LedgerReversal")

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@index([reversalOfId])
}

model ManualPayment {
  id                      String        @id @default(cuid())
  organizationId          String
  method                  PaymentMethod
  status                  PaymentStatus @default(DRAFT)
  amountBaisa             BigInt
  reference               String?
  chequeNumber            String?
  bankName                String?
  notes                   String?       @db.Text
  receivedAt              DateTime
  confirmedAt             DateTime?
  rejectedAt              DateTime?
  reversedAt              DateTime?
  rejectionReason         String?       @db.Text
  rejectionIdempotencyKey String?       @unique
  reversalReason          String?       @db.Text
  creditsGranted          BigInt?
  creditsPerBaisa         BigInt?
  idempotencyKey          String        @unique
  createdById             String
  confirmedById           String?
  ledgerEntryId           String?       @unique
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  organization            Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy               User          @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedBy             User?         @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([method, receivedAt])
}

model Project {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  description    String?         @db.Text
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  generationJobs GenerationJob[]
  assets         Asset[]
  chatThreads    ChatThread[]
  scripts        Script[]
  storyPlans     StoryPlan[]

  @@index([organizationId, archivedAt])
}

model ProviderModel {
  id                    String              @id @default(cuid())
  provider              ModelProvider
  providerModelId       String
  mediaKind             MediaKind
  displayName           String
  description           String              @db.Text
  capabilities          Json
  negotiatedDiscountBps Int                 @default(0)
  enabled               Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  priceVersions         ModelPriceVersion[]
  generationJobs        GenerationJob[]
  reasoningJobs         ReasoningJob[]

  @@unique([provider, providerModelId])
  @@index([mediaKind, enabled])
}

model ModelPriceVersion {
  id                    String           @id @default(cuid())
  providerModelId       String
  providerCostMicroUsd  BigInt
  publicationKey        String?          @unique @db.VarChar(36)
  publicationHash       String?          @db.VarChar(64)
  usageRates            Json?
  providerCostBasisNote String?          @db.VarChar(255)
  videoInputRate720p    BigInt?
  videoInputRate1080p   BigInt?
  customerCredits       BigInt
  fxBaisaNumerator      BigInt
  fxBaisaDenominator    BigInt
  targetMarginBps       Int
  pricingDimension      PricingDimension @default(REQUEST)
  unitQuantity          Int              @default(1)
  creditsPerBaisa       BigInt           @default(1)
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  createdById           String
  createdAt             DateTime         @default(now())
  providerModel         ProviderModel    @relation(fields: [providerModelId], references: [id], onDelete: Restrict)
  createdBy             User             @relation("PriceVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  generationJobs        GenerationJob[]

  @@index([providerModelId, effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
}

model GenerationJob {
  id                         String                 @id @default(cuid())
  organizationId             String
  projectId                  String?
  templateId                 String?
  createdById                String
  providerModelId            String
  priceVersionId             String
  status                     GenerationJobStatus    @default(DRAFT)
  idempotencyKey             String                 @unique
  requestPayload             Json
  outputPayload              Json?
  providerRequestId          String?
  reservedCredits            BigInt                 @default(0)
  chargedCredits             BigInt                 @default(0)
  actualProviderCostMicroUsd BigInt?
  providerCostBasis          String?                @db.VarChar(32)
  quotedUnits                Int?
  actualUnits                Int?
  billableQuantity           Int?
  errorCode                  String?
  errorMessage               String?                @db.Text
  quotedAt                   DateTime?
  queuedAt                   DateTime?
  submittedAt                DateTime?
  completedAt                DateTime?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  organization               Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project                    Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  template                   GenerationTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy                  User                   @relation("GenerationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  providerModel              ProviderModel          @relation(fields: [providerModelId], references: [id], onDelete: Restrict)
  priceVersion               ModelPriceVersion      @relation(fields: [priceVersionId], references: [id], onDelete: Restrict)
  assets                     Asset[]
  inputAssets                GenerationInputAsset[]

  @@unique([providerModelId, providerRequestId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, createdAt, id])
  @@index([organizationId, createdById, createdAt, id])
  @@index([projectId, createdAt])
  @@index([templateId, createdAt])
  @@index([status, updatedAt])
}

model GenerationTemplate {
  id               String                   @id @default(cuid())
  slug             String                   @unique
  name             String
  description      String                   @db.Text
  category         String
  mediaKind        MediaKind
  status           GenerationTemplateStatus @default(DRAFT)
  promptTemplate   String                   @db.Text
  variables        Json
  defaultInput     Json
  preferredModelId String?
  featured         Boolean                  @default(false)
  sortOrder        Int                      @default(0)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  generationJobs   GenerationJob[]
  favorites        TemplateFavorite[]

  @@index([status, mediaKind, featured, sortOrder])
  @@index([category, status])
}

model TemplateFavorite {
  userId     String
  templateId String
  createdAt  DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   GenerationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([userId, templateId])
  @@index([templateId, createdAt])
}

model Asset {
  id                    String                 @id @default(cuid())
  organizationId        String
  projectId             String?
  folderId              String?
  generationJobId       String?
  sourceAssetId         String?
  generationOutputIndex Int?
  storageOwnerUserId    String?
  createdById           String?
  uploadedById          String?
  status                AssetStatus            @default(PENDING)
  purpose               AssetPurpose           @default(GENERAL)
  mediaKind             AssetMediaKind         @default(OTHER)
  sourceType            AssetSourceType        @default(GENERATED)
  storageProvider       AssetStorageProvider   @default(LOCAL)
  name                  String?
  originalFilename      String?
  objectKey             String                 @unique
  mimeType              String
  byteSize              BigInt
  sha256                String?
  width                 Int?
  height                Int?
  durationMs            Int?
  deletedAt             DateTime?
  purgeAfter            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project               Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  folder                AssetFolder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  generationJob         GenerationJob?         @relation(fields: [generationJobId], references: [id], onDelete: SetNull)
  sourceAsset           Asset?                 @relation("AssetLineage", fields: [sourceAssetId], references: [id], onDelete: Restrict)
  derivedAssets         Asset[]                @relation("AssetLineage")
  imageOperation        ImageOperation?        @relation("ImageOperationOutput")
  sourceOperations      ImageOperation[]       @relation("ImageOperationSource")
  videoRenderOutputs    VideoRender[]          @relation("VideoRenderOutput")
  videoRenderInputs     VideoRenderInput[]
  storageOwner          User?                  @relation("AssetStorageOwner", fields: [storageOwnerUserId], references: [id], onDelete: SetNull)
  createdBy             User?                  @relation("AssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  uploadedBy            User?                  @relation("AssetUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  variants              AssetVariant[]
  generationInputs      GenerationInputAsset[]
  tagAssignments        AssetTagAssignment[]
  favorites             AssetFavorite[]

  @@unique([generationJobId, generationOutputIndex])
  @@index([organizationId, createdAt])
  @@index([organizationId, mediaKind, status, createdAt])
  @@index([organizationId, sourceType, status, createdAt])
  @@index([generationJobId])
  @@index([sourceAssetId])
  @@index([projectId, status, createdAt])
  @@index([folderId, status, createdAt])
  @@index([status, purgeAfter])
  @@index([organizationId, storageOwnerUserId, status])
  @@index([organizationId, sha256])
}

model ImageOperation {
  id             String               @id @default(cuid())
  organizationId String
  createdById    String
  sourceAssetId  String
  outputAssetId  String               @unique
  idempotencyKey String               @unique
  requestPayload Json
  status         ImageOperationStatus @default(PENDING)
  errorMessage   String?
  processingAt   DateTime?
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  sourceAsset    Asset                @relation("ImageOperationSource", fields: [sourceAssetId], references: [id], onDelete: Restrict)
  outputAsset    Asset                @relation("ImageOperationOutput", fields: [outputAssetId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdById, createdAt])
  @@index([status, updatedAt])
}

enum VideoRenderStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

model VideoEdit {
  id             String        @id @default(cuid())
  organizationId String
  projectId      String?
  createdById    String
  title          String
  revision       Int           @default(1)
  document       Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  renders        VideoRender[]

  @@index([organizationId, updatedAt])
}

model VideoRender {
  id             String             @id @default(cuid())
  editId         String
  organizationId String
  createdById    String
  outputAssetId  String             @unique
  idempotencyKey String             @unique
  revision       Int
  document       Json
  status         VideoRenderStatus  @default(PENDING)
  processingAt   DateTime?
  completedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  edit           VideoEdit          @relation(fields: [editId], references: [id], onDelete: Restrict)
  outputAsset    Asset              @relation("VideoRenderOutput", fields: [outputAssetId], references: [id], onDelete: Restrict)
  inputs         VideoRenderInput[]

  @@index([status, updatedAt])
  @@index([organizationId, createdById, createdAt])
}

model VideoRenderInput {
  renderId String
  assetId  String
  render   VideoRender @relation(fields: [renderId], references: [id], onDelete: Restrict)
  asset    Asset       @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([renderId, assetId])
  @@index([assetId])
}

model GenerationInputAsset {
  generationJobId String
  assetId         String
  position        Int
  role            GenerationInputRole @default(LEGACY)
  createdAt       DateTime      @default(now())
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  asset           Asset         @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([generationJobId, assetId])
  @@unique([generationJobId, position])
  @@index([generationJobId, role, position])
  @@index([assetId])
}

model AssetFolder {
  id             String        @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         AssetFolder?  @relation("AssetFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       AssetFolder[] @relation("AssetFolderTree")
  assets         Asset[]

  @@index([organizationId, parentId, name])
}

model AssetTag {
  id             String               @id @default(cuid())
  organizationId String
  name           String
  normalizedName String
  createdAt      DateTime             @default(now())
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    AssetTagAssignment[]

  @@unique([organizationId, normalizedName])
  @@index([organizationId, name])
}

model AssetTagAssignment {
  assetId   String
  tagId     String
  createdAt DateTime @default(now())
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag       AssetTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([assetId, tagId])
  @@index([tagId, assetId])
}

model AssetFavorite {
  assetId   String
  userId    String
  createdAt DateTime @default(now())
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([assetId, userId])
  @@index([userId, createdAt])
}

model AssetVariant {
  id              String               @id @default(cuid())
  assetId         String
  kind            AssetVariantKind
  storageProvider AssetStorageProvider @default(LOCAL)
  objectKey       String               @unique
  mimeType        String
  byteSize        BigInt
  sha256          String?
  width           Int?
  height          Int?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  asset           Asset                @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, kind])
  @@index([assetId])
}

model AssetStorageUsage {
  organizationId  String       @id
  usedBytes       BigInt       @default(0)
  reservedBytes   BigInt       @default(0)
  readyAssetCount Int          @default(0)
  version         Int          @default(0)
  reconciledAt    DateTime?
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id             String        @id @default(cuid())
  actorUserId    String?
  organizationId String?
  action         String
  targetType     String
  targetId       String?
  requestId      String?
  ipAddress      String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([organizationId, createdAt])
  @@index([targetType, targetId])
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  token          String           @unique
  email          String?
  role           MembershipRole   @default(ORGANIZATION_MEMBER)
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  createdById    String
  acceptedById   String?
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User             @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy     User?            @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([token])
  @@index([email])
}

enum MailKind {
  SECURITY
  ROUTINE
}

enum MailPriority {
  HIGH
  NORMAL
}

enum MailStatus {
  PENDING
  QUEUED
  SENDING
  RETRY
  SENT
  FAILED
  SUPPRESSED
}

model MailMessage {
  id                String       @id @default(cuid())
  kind              MailKind
  priority          MailPriority @default(NORMAL)
  status            MailStatus   @default(PENDING)
  template          String
  recipient         String
  subject           String
  textBody          String       @db.LongText
  htmlBody          String       @db.LongText
  sensitive         Boolean      @default(false)
  userId            String?
  organizationId    String?
  idempotencyKey    String       @unique
  attemptCount      Int          @default(0)
  nextAttemptAt     DateTime?
  providerMessageId String?
  lastErrorCode     String?
  lastErrorMessage  String?      @db.Text
  queuedAt          DateTime?
  sendingAt         DateTime?
  sentAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status, priority, createdAt])
  @@index([status, nextAttemptAt])
  @@index([status, sendingAt])
  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([recipient, createdAt])
}

enum ReasoningJobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

model ReasoningJob {
  id                String             @id @default(cuid())
  organizationId    String
  createdById       String
  providerModelId   String
  status            ReasoningJobStatus @default(QUEUED)
  idempotencyKey    String             @unique
  requestPayload    Json
  outputPayload     Json?
  providerRequestId String?
  inputTokens       Int?
  outputTokens      Int?
  errorCode         String?
  errorMessage      String?            @db.Text
  queuedAt          DateTime?
  processingAt      DateTime?
  completedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy     User          @relation("ReasoningCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  providerModel ProviderModel @relation(fields: [providerModelId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
  @@index([createdById, organizationId, status, createdAt])
  @@index([createdById, organizationId, createdAt])
  @@index([status, updatedAt])
  @@index([providerRequestId])
}

enum MediaTaskStatus {
  PENDING
  PROCESSING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  REVIEW
}

model MediaTask {
  id                String             @id @default(cuid())
  taskKey           String             @unique @db.VarChar(191)
  targetId          String             @db.VarChar(128)
  organizationId    String             @db.VarChar(128)
  kind              String             @db.VarChar(32)
  processingVersion Int                @default(1)
  status            MediaTaskStatus    @default(PENDING)
  cycle             Int                @default(1)
  attemptCount      Int                @default(0)
  maxAttempts       Int                @default(3)
  nextAttemptAt     DateTime?
  owner             String?            @db.VarChar(64)
  fence             Int                @default(0)
  leaseUntil        DateTime?
  errorCode         String?            @db.VarChar(64)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  attempts          MediaTaskAttempt[]

  @@index([status, nextAttemptAt, updatedAt])
  @@index([status, updatedAt])
  @@index([organizationId, createdAt])
}

model MediaTaskAttempt {
  id              String    @id @default(cuid())
  taskId          String
  cycle           Int
  number          Int
  fence           Int
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  outcome         String?   @db.VarChar(32)
  errorCode       String?   @db.VarChar(64)
  outputObjectKey String?   @db.VarChar(191)
  task            MediaTask @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([taskId, fence])
  @@index([finishedAt, outcome])
}

model MediaCapacity {
  id         String    @id @db.VarChar(64)
  owner      String?   @db.VarChar(64)
  fence      Int       @default(0)
  leaseUntil DateTime?
  updatedAt  DateTime  @updatedAt
}

model Persona {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  avatarUrl      String?
  tag            String?
  description    String?      @db.Text
  systemPrompt   String       @db.Text
  voiceKey       String?
  modelId        String       @default("doubao-seed-character-260628")
  isPreset       Boolean      @default(false)
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  chatThreads    ChatThread[]

  @@index([organizationId, isPreset, createdAt])
}

model ChatThread {
  id             String        @id @default(cuid())
  organizationId String
  projectId      String?
  createdById    String
  personaId      String?
  title          String
  modelId        String        @default("doubao-seed-character-260628")
  systemPrompt   String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy      User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  persona        Persona?      @relation(fields: [personaId], references: [id], onDelete: SetNull)
  messages       ChatMessage[]

  @@index([organizationId, createdById, updatedAt])
  @@index([projectId])
}

model ChatMessage {
  id              String     @id @default(cuid())
  threadId        String
  clientRequestId String?
  role            String
  content     String     @db.LongText
  tokensUsed  Int?
  metadata    Json?
  createdAt   DateTime   @default(now())

  thread      ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, clientRequestId, role])
  @@index([threadId, createdAt])
}

model Script {
  id                    String       @id @default(cuid())
  organizationId        String
  projectId             String?
  title                 String
  description           String?      @db.Text
  logline               String?      @db.Text
  targetDurationSeconds Int?
  content               Json
  revision              Int          @default(1)
  createdById           String
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project               Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy             User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, updatedAt])
}

model BrandProfile {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  tagline        String?
  voiceTone      String?      @db.Text
  guidelines     String?      @db.Text
  targetAudience String?      @db.Text
  vocabulary     Json?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, updatedAt])
}

model StoryPlan {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  title          String
  genre          String?
  premise        String?      @db.Text
  structureType  String       @default("THREE_ACT")
  beats          Json
  characters     Json
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, updatedAt])
}
