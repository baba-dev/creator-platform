# Runtime
NODE_ENV=development
APP_ENV=local
APP_VERSION=dev
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
SIGNUPS_ENABLED=true
# Security 2.0; enable only with production Turnstile widget keys after verification.
TURNSTILE_MODE=off
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Transactional email. Production uses implicit TLS SMTP (port 465).
# Web and worker services must load the same SMTP and sender settings.
# Never expose SMTP credentials through NEXT_PUBLIC_* variables.
MAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Independent login for routine sender. Required on staging and production.
ROUTINE_USER=creator-tool@aiwamediagroup.com
ROUTINE_USER_PASSWORD=
SMTP_EHLO_NAME=creator.aiwamediagroup.com
SMTP_POOL_MAX_CONNECTIONS=3
SMTP_POOL_MAX_MESSAGES=100
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
MAIL_SECURITY_FROM_ADDRESS=security@aiwamediagroup.com
MAIL_ROUTINE_FROM_ADDRESS=creator-tool@aiwamediagroup.com

# MariaDB. Credentials below are for local Compose only.
MARIADB_DATABASE=creator_platform
MARIADB_USER=creator
MARIADB_PASSWORD=creator_local_only
MARIADB_ROOT_PASSWORD=root_local_only
DATABASE_URL=mysql://creator:creator_local_only@127.0.0.1:3306/creator_platform

# Queue and cache
# Production may use unauthenticated Redis only when it is loopback-bound.
# Remote Redis must use authentication; prefer rediss:// when crossing hosts.
REDIS_URL=redis://127.0.0.1:6379/0
# Bounded by server config to 1-10 concurrent generation jobs per worker.
GENERATION_WORKER_CONCURRENCY=3
# Restart creator-worker after changing these. false pauses edits/exports/previews,
# while provider orchestration, mandatory validation, settlement and mail continue.
MEDIA_PROCESSING_ENABLED=true
MEDIA_THREADS=1
MEDIA_DERIVATIVE_TIMEOUT_MS=60000

# Local S3-compatible storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=creator-platform-local
S3_ACCESS_KEY_ID=creator_local_only
S3_SECRET_ACCESS_KEY=creator_local_secret_only
S3_FORCE_PATH_STYLE=true

# BytePlus media generation (server and worker only)
BYTEPLUS_API_KEY=
BYTEPLUS_REGION=ap-southeast-1
BYTEPLUS_MODELARK_BASE_URL=
# OmniHuman 1.5 uses BytePlus Vision AK/SK authentication, not ModelArk bearer keys.
BYTEPLUS_VISION_ACCESS_KEY_ID=
BYTEPLUS_VISION_SECRET_ACCESS_KEY=
BYTEPLUS_VISION_BASE_URL=https://cv.byteplusapi.com
# Seed Speech v3 uses a separate product API key; ModelArk keys do not work.
BYTEPLUS_SPEECH_API_KEY=
BYTEPLUS_SPEECH_APP_KEY=aGjiRDfUWi
BYTEPLUS_SPEECH_BASE_URL=
# AI MediaKit uses a product API key (Bearer auth), separate from ModelArk/Vision.
BYTEPLUS_MEDIAKIT_API_KEY=
BYTEPLUS_MEDIAKIT_BASE_URL=https://mediakit.ap-southeast-1.bytepluses.com
BYTEPLUS_MEDIAKIT_REQUEST_TIMEOUT_MS=180000
BYTEPLUS_MEDIAKIT_IDLE_TIMEOUT_MS=30000
BYTEPLUS_REQUEST_TIMEOUT_MS=180000
BYTEPLUS_IDLE_TIMEOUT_MS=30000
# Required only when deliberately running the billable live smoke command.
BYTEPLUS_LIVE_SMOKE_ACK=
BYTEPLUS_SMOKE_OUTPUT_DIR=
BYTEPLUS_SMOKE_PROMPT=

# NVIDIA creative reasoning (server and worker only)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_REASONING_MODEL=
NVIDIA_REQUEST_TIMEOUT_MS=60000
NVIDIA_IDLE_TIMEOUT_MS=30000

# Groq Cloud (server/worker only)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b
GROQ_REQUEST_TIMEOUT_MS=45000
GROQ_IDLE_TIMEOUT_MS=30000

# Google Gemini (server/worker only)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_DEFAULT_MODEL=gemini-3.8-flash
GEMINI_REQUEST_TIMEOUT_MS=45000
GEMINI_IDLE_TIMEOUT_MS=30000

# Cloudflare Workers AI (server/worker only)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_REQUEST_TIMEOUT_MS=45000
CLOUDFLARE_IDLE_TIMEOUT_MS=30000

# PWA Web Push: generate a P-256 VAPID private key, base64url encode 32 raw bytes.
# Configure identically on web and worker; never use NEXT_PUBLIC_ for this secret.
PWA_VAPID_PRIVATE_KEY=
PWA_VAPID_SUBJECT=mailto:creator-tool@aiwamediagroup.com

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# Shared persistent directory, writable by web and worker service user.
ASSET_STORAGE_ROOT=/var/www/creator-platform/shared/assets
IMAGE_IMPORT_ALLOWED_HOSTS=images.unsplash.com
# Exact trusted HTTPS hosts only; empty disables video link import.
VIDEO_IMPORT_ALLOWED_HOSTS=
