#!/usr/bin/env bash
set -Eeuo pipefail
umask 027

readonly application_root=/var/www/creator-platform
readonly releases_root="$application_root/releases"
readonly incoming_root="$application_root/incoming"
readonly current_link="$application_root/current"
readonly environment_file=/etc/aiwa-creators/creator.env
readonly backup_root=/var/backups/creator-platform
readonly runtime_user=aiwa-creator
readonly runtime_group=aiwa-creator
readonly release_layout=3
readonly control_plane_version=3
readonly control_plane_manifest=ops/control-plane.sha256

log() {
  printf '[creator-deploy] %s\n' "$*"
}

fail() {
  log "ERROR: $*" >&2
  exit 1
}

find_next_runtime() {
  local directory="$1"
  find "$directory" \
    -path '*/node_modules/next/package.json' \
    -print -quit 2>/dev/null
}

validate_runtime() {
  local directory="$1"
  [[ -d "$directory" ]] \
    && [[ -f "$directory/apps/web/server.js" ]] \
    && [[ -f "$directory/apps/worker/dist/index.cjs" ]] \
    && [[ -f "$directory/apps/worker/dist/byteplus-smoke.cjs" ]] \
    && [[ -n "$(find_next_runtime "$directory")" ]]
}

validate_control_plane() {
  local directory="$1"

  [[ -f "$directory/$control_plane_manifest" ]] \
    && (
      cd "$directory"
      sha256sum --check --strict --status "$control_plane_manifest"
    )
}

validate_release_contents() {
  local directory="$1"
  local expected_sha="$2"

  validate_runtime "$directory" \
    && [[ "$(cat "$directory/RELEASE_SHA" 2>/dev/null)" == "$expected_sha" ]] \
    && [[ "$(cat "$directory/RELEASE_LAYOUT" 2>/dev/null)" == "$release_layout" ]] \
    && [[ -x "$directory/ops/db/node_modules/.bin/prisma" ]] \
    && [[ -x "$directory/ops/db/node_modules/.bin/tsx" ]] \
    && [[ -f "$directory/ops/db/prisma/schema.prisma" ]] \
    && [[ -d "$directory/ops/db/prisma/migrations" ]] \
    && [[ -f "$directory/ops/db/prisma/promote-owner.ts" ]] \
    && [[ -f "$directory/ops/db/prisma/seed-templates.ts" ]] \
    && [[ -f "$directory/ops/db/prisma/template-catalog.ts" ]] \
    && [[ -f "$directory/ops/db/prisma/templates.ts" ]] \
    && [[ -x "$directory/ops/bin/creator-deploy" ]] \
    && [[ -x "$directory/ops/bin/creator-ops" ]] \
    && validate_control_plane "$directory"
}

validate_release_permissions() {
  local directory="$1"
  local unsafe=""

  [[ "$(stat -c '%U' "$directory" 2>/dev/null)" == root ]] || return 1
  unsafe="$(find "$directory" -xdev \( -type f -o -type d \) \
    \( ! -user root -o -perm /022 \) -print -quit 2>/dev/null)"
  [[ -z "$unsafe" ]] || return 1
  unsafe="$(find "$directory" -xdev -type l ! -user root -print -quit 2>/dev/null)"
  [[ -z "$unsafe" ]]
}

harden_release_tree() {
  local directory="$1"

  chown -hR root:"$runtime_group" "$directory"
  chmod -R u=rwX,g=rX,o= "$directory"
  validate_release_permissions "$directory"
}

validate_release() {
  local directory="$1"
  local expected_sha="$2"

  validate_release_contents "$directory" "$expected_sha" \
    && validate_release_permissions "$directory"
}

validate_release_path() {
  local directory="$1"
  local expected_sha=""

  [[ -n "$directory" && -d "$directory" ]] || return 1
  expected_sha="$(cat "$directory/RELEASE_SHA" 2>/dev/null || true)"
  [[ "$expected_sha" =~ ^[0-9a-f]{40}$ ]] \
    && validate_release "$directory" "$expected_sha"
}

load_environment_migrate_and_seed_templates() {
  local directory="$1"

  runuser --preserve-environment -u "$runtime_user" -- \
    /bin/bash -s -- "$directory" "$environment_file" <<'MIGRATE'
set -Eeuo pipefail
release_dir="$1"
environment_file="$2"

while IFS= read -r line || [[ -n "$line" ]]; do
  line="${line%$'\r'}"
  [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
  key="${line%%=*}"
  value="${line#*=}"
  [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
  if [[ "$value" =~ ^\".*\"$ || "$value" =~ ^\'.*\'$ ]]; then
    value="${value:1:${#value}-2}"
  fi
  export "$key=$value"
done <"$environment_file"

export HOME=/var/www/creator-platform
export XDG_CACHE_HOME=/var/www/creator-platform/.cache
export XDG_CONFIG_HOME=/var/www/creator-platform/.config
export XDG_STATE_HOME=/var/www/creator-platform/.local/state

cd "$release_dir/ops/db"
./node_modules/.bin/prisma migrate deploy --schema prisma/schema.prisma
./node_modules/.bin/tsx prisma/seed-templates.ts
MIGRATE
}

[[ $EUID -eq 0 ]] || fail "this command must run as root"

if [[ "${1:-}" == "--version" ]]; then
  printf '%s\n' "$control_plane_version"
  exit 0
fi

release_sha="${1:-}"
archive_argument="${2:-}"

[[ "$release_sha" =~ ^[0-9a-f]{40}$ ]] || fail "invalid release SHA"
[[ -n "$archive_argument" ]] || fail "release archive path is required"

archive_path="$(readlink -f -- "$archive_argument")"
expected_archive="$incoming_root/creator-platform-${release_sha}.tar.gz"
[[ "$archive_path" == "$expected_archive" ]] || fail "unexpected archive path"
[[ -f "$archive_path" ]] || fail "release archive does not exist"
[[ -f "$environment_file" ]] || fail "environment file does not exist"

# Web probes uploaded media and the worker renders edits. Check before migrations.
for media_binary in ffmpeg ffprobe; do
  command -v "$media_binary" >/dev/null 2>&1 \
    || fail "$media_binary is required; install ffmpeg on the host before deployment"
done

exec 9>/run/lock/creator-platform-deploy.lock
flock -n 9 || fail "another deployment is already running"

# Explicit runtime-writable state lives outside immutable releases.
install -d -o "$runtime_user" -g "$runtime_group" -m 0750 \
  "$application_root/shared" \
  "$application_root/.cache" \
  "$application_root/.cache/next" \
  "$application_root/.config" \
  "$application_root/.local/state"

if tar -tzf "$archive_path" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then
  fail "release archive contains an unsafe path"
fi

release_dir="$releases_root/sha-$release_sha"
temporary_dir=""
previous_release="$(readlink -f "$current_link" 2>/dev/null || true)"
if [[ -n "$previous_release" ]] && ! validate_release_path "$previous_release"; then
  log "active previous release is not trusted for rollback; fail-closed rollback will apply"
  previous_release=""
fi

cleanup() {
  if [[ -n "$temporary_dir" && -d "$temporary_dir" ]]; then
    rm -rf -- "$temporary_dir"
  fi
}
trap cleanup EXIT

release_ready=false
replace_existing=false

if [[ -d "$release_dir" ]]; then
  if validate_release "$release_dir" "$release_sha"; then
    release_ready=true
    log "release is already extracted and passed integrity checks"
  else
    replace_existing=true
    log "existing release failed integrity checks; rebuilding it from the uploaded archive"
  fi
fi

if [[ "$release_ready" != true ]]; then
  temporary_dir="$(mktemp -d "$releases_root/.extract-${release_sha}.XXXXXX")"
  tar --no-same-owner --no-same-permissions -xzf "$archive_path" -C "$temporary_dir"

  validate_release_contents "$temporary_dir" "$release_sha" \
    || fail "extracted release failed content and control-plane integrity checks"
  harden_release_tree "$temporary_dir" \
    || fail "extracted release could not be made root-owned and runtime-read-only"
  validate_release "$temporary_dir" "$release_sha" \
    || fail "extracted release failed hardened integrity checks"

  install -d -o root -g root -m 0700 "$backup_root"
  backup_path="$backup_root/predeploy-$(date -u +%Y%m%dT%H%M%SZ)-${release_sha}.sql.gz"
  log "backing up creator_platform database"
  mariadb-dump --single-transaction --quick --routines --triggers creator_platform \
    | gzip -1 >"$backup_path"
  chmod 0600 "$backup_path"

  log "applying database migrations and ensuring template catalog"
  load_environment_migrate_and_seed_templates "$temporary_dir"
  validate_release "$temporary_dir" "$release_sha" \
    || fail "release integrity changed while running deployment operations"

  if [[ "$replace_existing" == true ]]; then
    quarantine_dir="$releases_root/quarantine-${release_sha}-$(date -u +%Y%m%dT%H%M%SZ)"
    mv -- "$release_dir" "$quarantine_dir"
    log "moved the invalid release to $quarantine_dir"

  fi

  mv -- "$temporary_dir" "$release_dir"
  temporary_dir=""
  log "release extracted, verified, migrated, and template catalog ensured"
fi

# Preserve the operator-selected topology. Drain every active worker before
# switching the shared symlink so old code cannot claim work from the new release.
worker_services=()
for unit in creator-worker.service creator-worker@all.service creator-worker@core.service creator-worker@orchestration.service creator-worker@mail.service creator-worker@media.service; do
  if systemctl is-active --quiet "$unit" || systemctl is-enabled --quiet "$unit"; then
    worker_services+=("$unit")
  fi
done
[[ ${#worker_services[@]} -gt 0 ]] || fail "no worker service is selected"
selected=" ${worker_services[*]} "
if [[ ( "$selected" == *' creator-worker.service '* || "$selected" == *' creator-worker@all.service '* ) && ${#worker_services[@]} -gt 1 ]] \
  || [[ "$selected" == *' creator-worker@core.service '* && ( "$selected" == *' creator-worker@mail.service '* || "$selected" == *' creator-worker@orchestration.service '* ) ]]; then
  fail "overlapping worker roles selected; correct enabled/active services before deployment"
fi
if ! systemctl stop "${worker_services[@]}"; then
  systemctl start "${worker_services[@]}" || true
  fail "workers failed to stop; release symlink was not changed"
fi

new_link="$application_root/.current-$release_sha"
rm -f -- "$new_link"
ln -s "$release_dir" "$new_link"
mv -Tf "$new_link" "$current_link"

rollback() {
  log "health check failed; rolling application symlink back" >&2
  systemctl stop "${worker_services[@]}" || true
  if [[ -n "$previous_release" ]] && validate_release_path "$previous_release"; then
    rollback_link="$application_root/.rollback-$release_sha"
    rm -f -- "$rollback_link"
    ln -s "$previous_release" "$rollback_link"
    mv -Tf "$rollback_link" "$current_link"
    if [[ "$selected" == *' creator-worker@'* && ! -f "$previous_release/ops/systemd/creator-worker@.service" ]]; then
      systemctl restart creator-web.service || true
      log "previous release predates role isolation; workers remain stopped. Disable template instances and enable the legacy worker before resuming." >&2
    else
      systemctl restart creator-web.service "${worker_services[@]}" || true
    fi
  else
    rm -f -- "$current_link"
    systemctl stop creator-web.service "${worker_services[@]}" || true
    log "no valid previous runtime was available for rollback" >&2
  fi
  exit 1
}

log "restarting application services"
systemctl restart creator-web.service "${worker_services[@]}" || rollback

healthy=false
for _ in {1..30}; do
  health_response="$(curl -fsS --max-time 3 http://127.0.0.1:3000/api/health 2>/dev/null || true)"
  active_release_sha="$(cat "$current_link/RELEASE_SHA" 2>/dev/null || true)"

  if [[ "$health_response" == *'"status":"ok"'* \
     && "$active_release_sha" == "$release_sha" ]]; then
    healthy=true
    break
  fi
  sleep 2
done

[[ "$healthy" == true ]] || rollback
for unit in "${worker_services[@]}"; do
  systemctl is-active --quiet "$unit" || rollback
done

# Promote root control-plane artifacts only from the verified, immutable release.
if ! validate_release "$release_dir" "$release_sha"; then
  log "active release failed integrity checks before control-plane promotion" >&2
  rollback
fi
log "promoting verified root control-plane artifacts"
install -o root -g root -m 0755 \
  "$release_dir/ops/bin/creator-deploy" \
  /usr/local/sbin/creator-deploy
install -o root -g root -m 0755 \
  "$release_dir/ops/bin/creator-ops" \
  /usr/local/sbin/creator-ops
install -o root -g root -m 0644 \
  "$release_dir/ops/systemd/creator-web.service" \
  /etc/systemd/system/creator-web.service
install -o root -g root -m 0644 \
  "$release_dir/ops/systemd/creator-worker.service" \
  /etc/systemd/system/creator-worker.service
install -o root -g root -m 0644 \
  "$release_dir/ops/systemd/creator-worker@.service" \
  /etc/systemd/system/creator-worker@.service
install -d -o root -g root -m 0755 \
  /etc/systemd/system/creator-worker@media.service.d
install -o root -g root -m 0644 \
  "$release_dir/ops/systemd/creator-worker@media.service.d/limits.conf" \
  /etc/systemd/system/creator-worker@media.service.d/limits.conf
systemctl daemon-reload

# Restart once more so the promoted filesystem sandbox applies to this release,
# not merely the next deployment.
log "restarting application services under the hardened filesystem sandbox"
systemctl restart creator-web.service "${worker_services[@]}" || rollback

healthy=false
for _ in {1..30}; do
  health_response="$(curl -fsS --max-time 3 http://127.0.0.1:3000/api/health 2>/dev/null || true)"
  active_release_sha="$(cat "$current_link/RELEASE_SHA" 2>/dev/null || true)"

  if [[ "$health_response" == *'"status":"ok"'* \
     && "$active_release_sha" == "$release_sha" ]]; then
    healthy=true
    break
  fi
  sleep 2
done
[[ "$healthy" == true ]] || rollback
for unit in "${worker_services[@]}"; do
  systemctl is-active --quiet "$unit" || rollback
done

rm -f -- "$archive_path"
log "deployment completed: $release_sha"
