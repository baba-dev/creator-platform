{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env", ".env.local"],
  "globalEnv": ["NODE_ENV", "APP_ENV", "APP_VERSION"],
  "globalPassThroughEnv": [
    "APP_URL",
    "AUTH_SECRET",
    "DATABASE_URL",
    "SIGNUPS_ENABLED",
    "REDIS_URL",
    "ASSET_STORAGE_ROOT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["GENERATION_INTEGRATION_TEST"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
