# Runtime
NODE_ENV=development
APP_ENV=local
APP_VERSION=dev
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
SIGNUPS_ENABLED=true
# Transactional email. Production uses implicit TLS SMTP (port 465).
# Web and worker services must load the same SMTP and sender settings.
# Never expose SMTP credentials through NEXT_PUBLIC_* variables.
MAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_EHLO_NAME=creator.aiwamediagroup.com
SMTP_SOCKET_TIMEOUT_MS=30000
MAIL_SECURITY_FROM_ADDRESS=security@aiwamediagroup.com
MAIL_ROUTINE_FROM_ADDRESS=creator-tool@aiwamediagroup.com

# MariaDB. Credentials below are for local Compose only.
MARIADB_DATABASE=creator_platform
MARIADB_USER=creator
MARIADB_PASSWORD=creator_local_only
MARIADB_ROOT_PASSWORD=root_local_only
DATABASE_URL=mysql://creator:creator_local_only@127.0.0.1:3306/creator_platform

# Queue and cache
REDIS_URL=redis://127.0.0.1:6379/0

# Local S3-compatible storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=creator-platform-local
S3_ACCESS_KEY_ID=creator_local_only
S3_SECRET_ACCESS_KEY=creator_local_secret_only
S3_FORCE_PATH_STYLE=true

# BytePlus media generation (server and worker only)
BYTEPLUS_API_KEY=
BYTEPLUS_REGION=ap-southeast-1
BYTEPLUS_MODELARK_BASE_URL=
# Seed Speech v3 uses a separate product API key; ModelArk keys do not work.
BYTEPLUS_SPEECH_API_KEY=
BYTEPLUS_SPEECH_APP_KEY=aGjiRDfUWi
BYTEPLUS_SPEECH_BASE_URL=
BYTEPLUS_REQUEST_TIMEOUT_MS=180000
BYTEPLUS_IDLE_TIMEOUT_MS=30000
# Required only when deliberately running the billable live smoke command.
BYTEPLUS_LIVE_SMOKE_ACK=
BYTEPLUS_SMOKE_OUTPUT_DIR=
BYTEPLUS_SMOKE_PROMPT=

# NVIDIA creative reasoning (server and worker only)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_REASONING_MODEL=
NVIDIA_REQUEST_TIMEOUT_MS=60000
NVIDIA_IDLE_TIMEOUT_MS=30000

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# Shared persistent directory, writable by web and worker service user.
ASSET_STORAGE_ROOT=/var/www/creator-platform/shared/assets
